# Copy to a private env file and pass it with --env-file. Keep the public
# origin equal to the actual browser URL; production normally uses port 443.
FASTCAS_DOMAIN=auth.example.com
FASTCAS_ISSUER=https://auth.example.com
FASTCAS_DB_PASSWORD=replace-with-url-safe-random-password
FASTCAS_PROXY_SECRET=replace-with-32-or-more-random-characters
