# Local Compose only. Choose a URL-safe random value; do not commit your .env.
FASTCAS_DB_PASSWORD=replace-with-url-safe-random-password
FASTCAS_ISSUER=http://127.0.0.1:8900
# Optional GitHub OAuth App for local development.
FASTCAS_GITHUB_CLIENT_ID=
FASTCAS_GITHUB_CLIENT_SECRET=
FASTCAS_GITHUB_REGISTRATION_ORG=
