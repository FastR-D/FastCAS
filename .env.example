FASTCAS_ENV=development
FASTCAS_LISTEN=127.0.0.1:8900
FASTCAS_ISSUER=http://127.0.0.1:8900
FASTCAS_DATABASE_URL=postgres://fastcas:replace-with-local-password@127.0.0.1:5432/fastcas?sslmode=disable
FASTCAS_KEYS_DIR=.local/keys
# Bootstrap command only. Do not leave bootstrap passwords in service environments.
FASTCAS_ADMIN_EMAIL=admin@example.test
FASTCAS_ADMIN_NAME=FastCAS Administrator
FASTCAS_ADMIN_PASSWORD=
# Optional prebuilt React security/admin console, served at /console/.
# Build with: cd web && npm ci && npm run build
# FASTCAS_UI_DIR=web/dist
