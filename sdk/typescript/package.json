{
  "name": "@fastrd/fastcas",
  "version": "0.1.2",
  "description": "Optional FastCAS login and account linking for FastR-D applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.14.0"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FastR-D/FastCAS.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/FastR-D/FastCAS",
  "bugs": {
    "url": "https://github.com/FastR-D/FastCAS/issues"
  },
  "keywords": [
    "fastcas",
    "oidc",
    "authentication"
  ],
  "publishConfig": {
    "access": "public"
  }
}
